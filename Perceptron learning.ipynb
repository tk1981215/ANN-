import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import make_blobs

# 1. Generate a linearly separable dataset
X, y = make_blobs(n_samples=100, centers=2, n_features=2, random_state=42)
y = np.where(y <= 0, 0, 1) # Ensure labels are 0 and 1

# 2. Initialize Hyperparameters
learning_rate = 0.1
epochs = 10

# 3. Initialize Weights and Bias to small random values (as per step 1 of your notes)
weights = np.random.randn(2)
bias = np.random.randn(1)

# 4. Activation Function (Step Function)
def step_function(z):
    return 1 if z >= 0 else 0

# 5. Training Loop (Perceptron Learning Algorithm)
for epoch in range(epochs):
    total_error = 0
    for i in range(len(X)):
        # Compute output: y_pred = f(w.x + b)
        linear_output = np.dot(X[i], weights) + bias
        y_pred = step_function(linear_output)
        
        # Calculate update term: learning_rate * (y_target - y_pred)
        update = learning_rate * (y[i] - y_pred)
        
        # Update weights and bias (as per your notes)
        weights += update * X[i]
        bias += update
        
        # Keep track of errors for monitoring
        if update != 0:
            total_error += 1
            
    print(f"Epoch {epoch+1}: Total classification errors = {total_error}")
    if total_error == 0:
        print("Convergence reached!")
        break

# --- Visualization ---
plt.scatter(X[:, 0], X[:, 1], c=y, cmap='bwr', edgecolors='k')

# Calculate the decision boundary line (w1*x1 + w2*x2 + b = 0)
x_points = np.linspace(X[:, 0].min(), X[:, 0].max(), 100)
y_points = -(weights[0] * x_points + bias) / weights[1]

plt.plot(x_points, y_points, color='black', label='Decision Boundary')
plt.title("Perceptron Classification")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.legend()
plt.show()
